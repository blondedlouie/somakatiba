",{"children":"Chapter 11: Devolved Government - Soma Katiba KE"}],["$","meta","1",{"name":"description","content":"Establishes 47 County Governments to decentralize state functions, distribute national resources equitably, and give communities direct control of local development."}],["$","meta","2",{"name":"keywords","content":"Kenya Constitution 2010,Katiba,Bill of Rights,Devolution,Article 35 ATI"}]]}]}],null]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}],"p":"$@1a","v":null,"s":"$6"}},"a":"$@1b","u":"$@1c","b":"rAeUi7gtUG7UDHDGQvYWg"}
