27:["$","nav",null,{"className":"pt-10 border-t border-rule grid grid-cols-1 sm:grid-cols-2 gap-4","aria-label":"Chapter Navigation","children":[["$","$Le",null,{"href":"/chapters/10","className":"p-5 rounded-card border border-rule hover:border-ink bg-white transition-colors group flex flex-col","children":[["$","span",null,{"className":"font-sans text-xs font-bold text-ink-muted mb-1","children":"Previous chapter"}],["$","span",null,{"className":"font-sans font-bold text-base text-ink group-hover:underline group-hover:decoration-flag-red underline-offset-4","children":[["$","span",null,{"className":"text-flag-green font-black mr-2","children":[10,"."]}],"Judiciary"]}]]}],["$","$Le",null,{"href":"/chapters/12","className":"p-5 rounded-card border border-rule hover:border-ink bg-white transition-colors group flex flex-col text-left sm:text-right sm:col-start-2","children":[["$","span",null,{"className":"font-sans text-xs font-bold text-ink-muted mb-1","children":"Next chapter"}],["$","span",null,{"className":"font-sans font-bold text-base text-ink group-hover:underline group-hover:decoration-flag-red underline-offset-4","children":[["$","span",null,{"className":"text-flag-green font-black mr-2","children":[12,"."]}],"Public Finance"]}]]}]]}]
