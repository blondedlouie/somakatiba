17:["$","section",null,{"className":"p-6 sm:p-8 bg-paper border border-rule border-l-[6px] border-l-flag-green rounded-card","children":[["$","h2",null,{"className":"font-sans font-bold text-base sm:text-lg text-ink mb-3","children":"Key constitutional takeaways"}],["$","ul",null,{"className":"space-y-2.5","children":[["$","li","0",{"className":"font-serif text-[17px] text-ink leading-relaxed flex items-start gap-2.5","children":[["$","span",null,{"className":"font-sans font-black text-flag-green text-sm flex-shrink-0 mt-0.5","children":"•"}],["$","span",null,{"children":"Kenya is a sovereign multi-party democratic Republic."}]]}],["$","li","1",{"className":"font-serif text-[17px] text-ink leading-relaxed flex items-start gap-2.5","children":[["$","span",null,{"className":"font-sans font-black text-flag-green text-sm flex-shrink-0 mt-0.5","children":"•"}],["$","span",null,{"children":"Article 10 sets mandatory national values and principles of governance."}]]}],["$","li","2",{"className":"font-serif text-[17px] text-ink leading-relaxed flex items-start gap-2.5","children":[["$","span",null,{"className":"font-sans font-black text-flag-green text-sm flex-shrink-0 mt-0.5","children":"•"}],["$","span",null,{"children":"Official languages are Kiswahili and English, with national language being Kiswahili."}]]}]]}]]}]
18:["$","section",null,{"className":"space-y-6","children":[["$","div",null,{"children":[["$","h2",null,{"className":"text-[clamp(28px,3.6vw,44px)] font-black text-ink tracking-[-0.025em] leading-[1.05] font-sans","children":["Articles in Chapter ",2]}],["$","p",null,{"className":"font-serif text-ink-muted text-base mt-1","children":"Select an article to read its legal clauses and plain language meaning."}]]}],["$","$L1b",null,{"articles":[{"articleNumber":4,"title":"Declaration of the Republic","summary":"Kenya is a sovereign, multi-party democratic State founded on the national values and principles of governance referred to in Article 10.","content":"Kenya is a sovereign Republic.\n\nThe Republic of Kenya shall be a multi-party democratic State founded on the national values and principles of governance referred to in Article 10.","clauses":[{"clauseNumber":"(1)","text":"Kenya is a sovereign Republic."},{"clauseNumber":"(2)","text":"The Republic of Kenya shall be a multi-party democratic State founded on the national values and principles of governance referred to in Article 10."}],"plainExplanation":"No political faction can legally convert Kenya into a one-party state or dictatorship."},{"articleNumber":5,"title":"Territory of Kenya","content":"Kenya consists of the territory and territorial waters comprising Kenya on the effective date, and any additional territory and territorial waters as defined by an Act of Parliament."},{"articleNumber":6,"title":"Devolution and access to services","content":"The territory of Kenya is divided into the counties specified in the First Schedule.\n\nThe governments at the national and county levels are distinct and interdependent and shall conduct their mutual relations on the basis of consultation and cooperation.\n\nA national State organ shall ensure reasonable access to its services in all parts of the Republic, so far as it is appropriate to do so having regard to the nature of the service.","clauses":[{"clauseNumber":"(1)","text":"The territory of Kenya is divided into the counties specified in the First Schedule."},{"clauseNumber":"(2)","text":"The governments at the national and county levels are distinct and interdependent and shall conduct their mutual relations on the basis of consultation and cooperation."},{"clauseNumber":"(3)","text":"A national State organ shall ensure reasonable access to its services in all parts of the Republic, so far as it is appropriate to do so having regard to the nature of the service."}]},{"articleNumber":7,"title":"National, official and other languages","content":"The national language of the Republic is Kiswahili.\n\nThe official languages of the Republic are Kiswahili and English.\n\nThe State shall- (a) promote and protect the diversity of language of the people of Kenya; and (b) promote the development and use of indigenous languages, Kenyan Sign language, Braille and other communication formats and technologies accessible to persons with disabilities.","clauses":[{"clauseNumber":"(1)","text":"The national language of the Republic is Kiswahili."},{"clauseNumber":"(2)","text":"The official languages of the Republic are Kiswahili and English."},{"clauseNumber":"(3)","text":"The State shall- (a) promote and protect the diversity of language of the people of Kenya; and (b) promote the development and use of indigenous languages, Kenyan Sign language, Braille and other communication formats and technologies accessible to persons with disabilities."}]},{"articleNumber":8,"title":"State and religion","content":"There shall be no State religion."},{"articleNumber":9,"title":"National symbols and national days","content":"The national symbols of the Republic are- (a) the national flag; (b) the national anthem; (c) the coat of arms; and (d) the public seal.\n\nThe national symbols are as set out in the Second Schedule.\n\nThe national days are- (a) Madaraka Day, to be observed on 1st June; (b) Mashujaa Day, to be observed on 20th October; and (c) Jamhuri Day, to be observed on 12th December.\n\nA national day shall be a public holiday.\n\nParliament may enact legislation prescribing other public holidays, and providing for observance of public holidays.","clauses":[{"clauseNumber":"(1)","text":"The national symbols of the Republic are- (a) the national flag; (b) the national anthem; (c) the coat of arms; and (d) the public seal."},{"clauseNumber":"(2)","text":"The national symbols are as set out in the Second Schedule."},{"clauseNumber":"(3)","text":"The national days are- (a) Madaraka Day, to be observed on 1st June; (b) Mashujaa Day, to be observed on 20th October; and (c) Jamhuri Day, to be observed on 12th December."},{"clauseNumber":"(4)","text":"A national day shall be a public holiday."},{"clauseNumber":"(5)","text":"Parliament may enact legislation prescribing other public holidays, and providing for observance of public holidays."}]},{"articleNumber":10,"title":"National values and principles of governance","summary":"Binds all State organs, State officers, and public officers whenever applying, interpreting, or implementing the law or public policy.","content":"The national values and principles of governance in this Article bind all State organs, State officers, public officers and all persons whenever any of them- (a) applies or interprets this Constitution; (b) enacts, applies or interprets any law; or (c) makes or implements public policy decisions.\n\nThe national values and principles of governance include- (a) patriotism, national unity, sharing and devolution of power, the rule of law, democracy and participation of the people; (b) human dignity, equity, social justice, inclusiveness, equality, human rights, non-discrimination and protection of the marginalised; (c) good governance, integrity, transparency and accountability; and (d) sustainable development.","clauses":[{"clauseNumber":"(1)","text":"The national values and principles of governance in this Article bind all State organs, State officers, public officers and all persons whenever any of them- (a) applies or interprets this Constitution; (b) enacts, applies or interprets any law; or (c) makes or implements public policy decisions."},{"clauseNumber":"(2)","text":"The national values and principles of governance include- (a) patriotism, national unity, sharing and devolution of power, the rule of law, democracy and participation of the people; (b) human dignity, equity, social justice, inclusiveness, equality, human rights, non-discrimination and protection of the marginalised; (c) good governance, integrity, transparency and accountability; and (d) sustainable development."}],"plainExplanation":"Public participation, transparency, and human rights are mandatory legal standards for every government action."},{"articleNumber":11,"title":"Culture","content":"This Constitution recognises culture as the foundation of the nation and as the cumulative civilization of the Kenyan people and nation.\n\nThe State shall- (a) promote all forms of national and cultural expression through literature, the arts, traditional celebrations, science, communication, information, mass media, publications, libraries and other cultural heritage; (b) recognise the role of science and indigenous technologies in the development of the nation; and (c) promote the intellectual property rights of the people of Kenya.\n\nParliament shall enact legislation to- (a) ensure that communities receive compensation or royalties for the use of their cultures and cultural heritage; and (b) recognise and protect the ownership of indigenous seeds and plant varieties, their genetic and diverse characteristics and their use by the communities of Kenya.","clauses":[{"clauseNumber":"(1)","text":"This Constitution recognises culture as the foundation of the nation and as the cumulative civilization of the Kenyan people and nation."},{"clauseNumber":"(2)","text":"The State shall- (a) promote all forms of national and cultural expression through literature, the arts, traditional celebrations, science, communication, information, mass media, publications, libraries and other cultural heritage; (b) recognise the role of science and indigenous technologies in the development of the nation; and (c) promote the intellectual property rights of the people of Kenya."},{"clauseNumber":"(3)","text":"Parliament shall enact legislation to- (a) ensure that communities receive compensation or royalties for the use of their cultures and cultural heritage; and (b) recognise and protect the ownership of indigenous seeds and plant varieties, their genetic and diverse characteristics and their use by the communities of Kenya."}]}],"chapterNumber":2}]]}]
