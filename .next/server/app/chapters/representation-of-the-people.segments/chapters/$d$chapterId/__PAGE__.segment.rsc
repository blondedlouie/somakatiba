",{"children":"Chapter 7: Representation of the People - Soma Katiba KE"}],["$","meta","1",{"name":"description","content":"Governs the electoral system, general principles of voting, voter registration, political parties, and the Independent Electoral and Boundaries Commission (IEBC)."}],["$","meta","2",{"name":"keywords","content":"Kenya Constitution 2010,Katiba,Bill of Rights,Devolution,Article 35 ATI"}]]}]}],null]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}],"p":"$@1a","v":null,"s":"$6"}},"a":"$@1b","u":"$@1c","b":"rAeUi7gtUG7UDHDGQvYWg"}
