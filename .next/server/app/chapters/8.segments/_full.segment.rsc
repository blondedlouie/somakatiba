,["$","a","X",{"href":"https://x.com/somakatibake?s=11","target":"_blank","rel":"noopener noreferrer","aria-label":"Follow Soma Katiba KE on X","title":"X","className":"inline-flex h-9 w-9 items-center justify-center rounded-full border border-ink text-ink transition-colors hover:bg-ink hover:text-white [&_svg]:h-4 [&_svg]:w-4","children":["$","svg",null,{"viewBox":"0 0 24 24","fill":"currentColor","aria-hidden":"true","children":["$","path",null,{"d":"M18.901 1.153h3.68L14.54 11.023 24 22.847h-7.406l-5.8-7.585-6.634 7.585H.477l8.6-9.83L0 1.153h7.594l5.243 6.932zm-1.29 19.614h2.039L6.486 3.123h-2.19z"}]}]}]]}]]}]}],["$","main",null,{"className":"flex-1 max-w-[1180px] mx-auto px-4 sm:px-8 lg:px-12 py-10 sm:py-14 w-full space-y-12","children":[["$","section",null,{"className":"bg-white border border-rule rounded-card overflow-hidden","children":[["$","div",null,{"className":"p-6 sm:p-10","children":[["$","div",null,{"className":"flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 mb-4","children":[["$","span",null,{"className":"font-sans font-black text-6xl sm:text-[72px] text-flag-green leading-none","children":8}],["$","div",null,{"className":"flex items-center gap-2","children":[["$","span",null,{"className":"font-sans text-xs font-bold text-ink px-2.5 py-1 border border-ink rounded-card","children":"State Organs"}],["$","span",null,{"className":"font-sans text-xs font-bold text-ink px-2.5 py-1 border border-ink rounded-card","children":"Articles 93 to 128"}]]}]]}],["$","h1",null,{"className":"text-[clamp(32px,4.4vw,56px)] font-black text-ink tracking-[-0.03em] leading-[1.02] font-sans","children":"The Legislature"}],["$","p",null,{"className":"font-serif italic text-base sm:text-lg text-ink-muted mt-2","children":["Kiswahili: ","Bunge"]}],["$","p",null,{"className":"font-serif text-[17px] sm:text-[19px] text-ink mt-4 leading-relaxed max-w-3xl","children":"Establishes a bicameral Parliament comprising the National Assembly and the Senate. Details lawmaking processes, legislative oversight, and impeachment procedures."}]]}],"$L16"]}],"$L17","$L18","$L19"]}],"$L1a"]}]
