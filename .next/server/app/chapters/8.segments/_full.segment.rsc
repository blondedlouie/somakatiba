12:[["$","title","0",{"children":"Chapter 8: The Legislature - Soma Katiba KE"}],["$","meta","1",{"name":"description","content":"Establishes a bicameral Parliament comprising the National Assembly and the Senate. Details lawmaking processes, legislative oversight, and impeachment procedures."}],["$","meta","2",{"name":"keywords","content":"Kenya Constitution 2010,Katiba,Bill of Rights,Devolution,Article 35 ATI"}]]
