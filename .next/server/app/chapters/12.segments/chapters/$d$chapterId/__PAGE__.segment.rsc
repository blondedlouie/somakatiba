",{"children":"Chapter 12: Public Finance - Soma Katiba KE"}],["$","meta","1",{"name":"description","content":"Establishes principles of openness, accountability, and equitable public expenditure. Creates the Office of the Controller of Budget and Auditor-General."}],["$","meta","2",{"name":"keywords","content":"Kenya Constitution 2010,Katiba,Bill of Rights,Devolution,Article 35 ATI"}]]}]}],null]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}],"p":"$@1a","v":null,"s":"$6"}},"a":"$@1b","u":"$@1c","b":"rAeUi7gtUG7UDHDGQvYWg"}
