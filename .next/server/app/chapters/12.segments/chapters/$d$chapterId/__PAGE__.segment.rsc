13:["$","section",null,{"className":"space-y-6","children":[["$","div",null,{"children":[["$","h2",null,{"className":"text-[clamp(28px,3.6vw,44px)] font-black text-ink tracking-[-0.025em] leading-[1.05] font-sans","children":["Articles in Chapter ",12]}],["$","p",null,{"className":"font-serif text-ink-muted text-base mt-1","children":"Select an article to read its legal clauses and plain language meaning."}]]}],["$","$L21",null,{"articles":[{"articleNumber":201,"title":"Principles of public finance","summary":"Directs openness, accountability, equitable sharing of taxes, and prudent use of public money.","clauses":[{"clauseNumber":"(a)","text":"There shall be openness and accountability, including public participation in financial matters."},{"clauseNumber":"(b)","text":"The public finance system shall promote an equitable society: (i) the burden of taxation shall be shared fairly; (ii) revenue raised nationally shall be shared equitably between national and county governments; and (iii) expenditure shall promote equitable development of the country."},{"clauseNumber":"(c)","text":"The burdens and benefits of the use of resources and public borrowing shall be shared equitably between present and future generations."},{"clauseNumber":"(d)","text":"Public money shall be used in a prudent and responsible manner."},{"clauseNumber":"(e)","text":"Financial management shall be responsible, and fiscal reporting shall be clear."}],"plainExplanation":"Public debt, national budget approvals, and tax policies must undergo open public scrutiny and fair intergenerational balance."},{"articleNumber":228,"title":"Controller of Budget","summary":"Oversees the implementation of national and county budgets and approves withdrawals from public accounts.","clauses":[{"clauseNumber":"(4)","text":"The Controller of Budget shall oversee the implementation of the budgets of the national and county governments."},{"clauseNumber":"(5)","text":"The Controller of Budget shall not approve any withdrawal from a public fund unless satisfied that the withdrawal is authorised by law."}],"plainExplanation":"No government ministry or county executive can withdraw public funds without legal authorization from the Controller of Budget."},{"articleNumber":229,"title":"Auditor-General","summary":"Audits all public accounts of national and county governments, courts, commissions, and independent offices.","clauses":[{"clauseNumber":"(4)","text":"Within six months after the end of each financial year, the Auditor-General shall audit and report, in respect of that financial year, on: (a) the accounts of the national and county governments; (b) the accounts of all funds and authorities of the national and county governments; and (g) the accounts of all other public entities."}],"plainExplanation":"Provides objective, independent reports on public spending to uncover graft and ensure fiscal integrity."}],"chapterNumber":12}]]}]
