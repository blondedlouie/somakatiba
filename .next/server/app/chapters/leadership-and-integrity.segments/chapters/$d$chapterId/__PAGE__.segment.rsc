",{"children":"Chapter 6: Leadership and Integrity - Soma Katiba KE"}],["$","meta","1",{"name":"description","content":"Establishes that public office is a trust to be exercised with honor, dignity, and accountability to the people. Sets strict standards against conflicts of interest and corruption."}],["$","meta","2",{"name":"keywords","content":"Kenya Constitution 2010,Katiba,Bill of Rights,Devolution,Article 35 ATI"}]]}]}],null]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}],"p":"$@1a","v":null,"s":"$6"}},"a":"$@1b","u":"$@1c","b":"rAeUi7gtUG7UDHDGQvYWg"}
