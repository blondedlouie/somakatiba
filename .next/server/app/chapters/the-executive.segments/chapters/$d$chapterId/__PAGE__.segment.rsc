",{"children":"Chapter 9: The Executive - Soma Katiba KE"}],["$","meta","1",{"name":"description","content":"Structures the Executive comprising the President, Deputy President, and Cabinet Secretaries. Eliminates imperial presidency and subjects appointments to parliamentary vetting."}],["$","meta","2",{"name":"keywords","content":"Kenya Constitution 2010,Katiba,Bill of Rights,Devolution,Article 35 ATI"}]]}]}],null]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}],"p":"$@1a","v":null,"s":"$6"}},"a":"$@1b","u":"$@1c","b":"rAeUi7gtUG7UDHDGQvYWg"}
