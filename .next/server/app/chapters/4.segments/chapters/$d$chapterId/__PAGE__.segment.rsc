",{"children":"Chapter 4: The Bill of Rights - Soma Katiba KE"}],["$","meta","1",{"name":"description","content":"An integral part of Kenya's democratic state and the framework for social, economic, and cultural policies. Protects civil liberties, socio-economic entitlements, and marginalized groups."}],["$","meta","2",{"name":"keywords","content":"Kenya Constitution 2010,Katiba,Bill of Rights,Devolution,Article 35 ATI"}]]}]}],null]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}],"p":"$@1a","v":null,"s":"$6"}},"a":"$@1b","u":"$@1c","b":"rAeUi7gtUG7UDHDGQvYWg"}
